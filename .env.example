# Database Connections
# Main PMC CMS Complaints Database (remote)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# PMC Metadata Database (local sessions, templates, execution logs)
METADATA_DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5433/pmc_metadata_db

# OpenRouter API Key & LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENROUTER_LLM_MODEL=openrouter/free
